NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=shopapi
LOG_LEVEL=info

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=MMRgKJEhF6jxoMF1xAABrgSlT95lPSPFCv2tf5g-imFcg7vm4Mi0xj_jslxXeJHx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Dev-only admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@shopapi.dev
SEED_ADMIN_PASSWORD=change-me

# Proxies in front of the app: 0 locally, 1 behind an AWS load balancer
TRUST_PROXY=0
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
