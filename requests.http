### Install the "REST Client" extension in VS Code, then click "Send Request" above each block.
@base = http://localhost:4000/api/v1

### Health check
GET {{base}}/health

### Create a product
POST {{base}}/products
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "description": "RGB, hot-swappable switches",
  "priceInCents": 549900,
  "category": "electronics",
  "stock": 25
}

### List products (pagination, filter, sort)
GET {{base}}/products?page=1&limit=10&category=electronics&sort=-priceInCents

### Price range
GET {{base}}/products?minPrice=10000&maxPrice=600000

### Text search
GET {{base}}/products?search=keyboard

### Get one (paste an _id from the create response)
GET {{base}}/products/PASTE_ID_HERE

### Partial update
PATCH {{base}}/products/PASTE_ID_HERE
Content-Type: application/json

{ "stock": 20 }

### Delete
DELETE {{base}}/products/PASTE_ID_HERE

### Validation error example
POST {{base}}/products
Content-Type: application/json

{ "name": "x", "priceInCents": -5, "category": "toys" }

############ BRANDS & JOINS ############

### List brands (copy an _id from here)
GET {{base}}/brands

### One-to-many: brand with its products ($lookup)
GET {{base}}/brands/PASTE_BRAND_ID

### LEFT OUTER JOIN: every brand + product count / avg price / inventory value
GET {{base}}/brands/summary

### INNER JOIN: only brands that have products
GET {{base}}/brands/summary?hasProducts=true

### ANTI JOIN: brands with NO products
GET {{base}}/brands/summary?hasProducts=false

### INNER JOIN products -> brand: only branded products ($lookup + $unwind)
GET {{base}}/products/with-brand?join=inner

### LEFT JOIN products -> brand: all products, brand null if none
GET {{base}}/products/with-brand?join=left

### populate(): product list with brand embedded (application-side join)
GET {{base}}/products?limit=5

### Filter by reference (no join needed)
GET {{base}}/products?brand=PASTE_BRAND_ID

### Create a brand
POST {{base}}/brands
Content-Type: application/json

{ "name": "Puma", "country": "Germany" }

### Link a product to a brand (or "brand": null to unlink)
PATCH {{base}}/products/PASTE_PRODUCT_ID
Content-Type: application/json

{ "brand": "PASTE_BRAND_ID" }

############ AUTH ############
# Run "Login as admin" first: the token is captured automatically into {{adminToken}}.

### Register a customer
POST {{base}}/auth/register
Content-Type: application/json

{ "name": "Sourav", "email": "sourav@example.com", "password": "secret123" }

### Login as customer
# @name customerLogin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "sourav@example.com", "password": "secret123" }

### Login as admin (created by `npm run seed`)
# @name adminLogin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "admin@shopapi.dev", "password": "Admin@12345" }

@adminToken = {{adminLogin.response.body.data.accessToken}}
@customerToken = {{customerLogin.response.body.data.accessToken}}

### Who am I?
GET {{base}}/auth/me
Authorization: Bearer {{customerToken}}

### Customer tries to create a product -> 403
POST {{base}}/products
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{ "name": "Not allowed", "priceInCents": 100, "category": "home" }

### Admin creates a product -> 201
POST {{base}}/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{ "name": "Admin Product", "priceInCents": 100, "category": "home" }

### Get a new access token (REST Client sends the refreshToken cookie automatically)
POST {{base}}/auth/refresh

### Logout this device
POST {{base}}/auth/logout

### Logout every device
POST {{base}}/auth/logout-all
Authorization: Bearer {{adminToken}}
